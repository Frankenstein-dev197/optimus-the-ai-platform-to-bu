{
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"incremental": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@emotion/react",
		"lib": [
			"dom",
			"esnext",
			"dom.iterable"
		],
		"module": "preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"outDir": "build/",
		"preserveWatchOutput": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "esnext",
		"types": [
			"node",
			"react",
			"react-dom",
			"vite/client",
			"vitest/globals",
			"novnc__novnc"
		],
		"paths": {
			"#/*": [
				"./src/*"
			],
			"@optimus-ide-collab/pixel-storybook/storyapi": [
				"./src/stubs/pixel-storybook/storyapi"
			]
		}
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules/",
		"e2e/"
	]
}