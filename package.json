{
  "name": "optimus-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @optimus/web dev",
    "dev:platform": "pnpm --filter @optimus/platform-ui dev",
    "dev:api": "pnpm --filter @optimus/api-service dev",
    "prebuild": "pnpm -w -r --filter \"@optimus/*\" build",
    "build": "pnpm --filter @optimus/web build",
    "build:platform": "pnpm --filter @optimus/platform-ui build",
    "build:api": "pnpm --filter @optimus/api-service build",
    "lint": "pnpm --filter @optimus/web lint",
    "lint:platform": "pnpm --filter @optimus/platform-ui lint",
    "lint:api": "pnpm --filter @optimus/api-service lint",
    "start": "pnpm --filter @optimus/web start",
    "start:api": "pnpm --filter @optimus/api-service start"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "pnpm": {
    "overrides": {
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "@babel/runtime": "7.26.10",
      "@babel/helpers": "7.26.10",
      "esbuild": "^0.25.0",
      "form-data": "4.0.4",
      "prismjs": "1.30.0",
      "rollup": "4.59.0",
      "flatted": "3.4.2",
      "playwright": "1.55.1",
      "lodash": "4.18.1",
      "minimatch": "9.0.7",
      "glob": "10.5.0",
      "mdast-util-to-hast": "13.2.1",
      "dompurify": "3.4.0",
      "brace-expansion": "1.1.13",
      "qs": "6.14.2",
      "uuid": "11.1.1",
      "js-yaml": "3.14.2",
      "yaml": "2.8.3",
      "lodash-es": "4.18.1",
      "picomatch@>=4": "4.0.4",
      "@novnc/novnc": "1.5.0"
    },
    "ignoredBuiltDependencies": [
      "cpu-features",
      "msw",
      "protobufjs",
      "storybook-addon-remix-react-router"
    ],
    "onlyBuiltDependencies": [
      "esbuild",
      "odiff-bin",
      "ssh2"
    ]
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "resolutions": {
    "optionator": "0.9.3",
    "semver": "7.7.3"
  }
}
